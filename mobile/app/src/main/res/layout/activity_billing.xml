<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Subscription Plans"
        android:textColor="#00FF66"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvCurrentCredits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available Credits: Loading..."
        android:textColor="#A0AEC0"
        android:textSize="18sp"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weekly Plan"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7 Meals • ₱1,490.00"
            android:textColor="#A0AEC0"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnWeeklyPlan"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Subscribe Weekly"
            android:backgroundTint="#00FF66"
            android:textColor="#121212"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monthly Plan"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="30 Meals • ₱5,000.00"
            android:textColor="#A0AEC0"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnMonthlyPlan"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Subscribe Monthly"
            android:backgroundTint="#00FF66"
            android:textColor="#121212"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>